index e1a166b..ff9c8df 100644
--- a/servers/rendering/rendering_device.cpp
+++ b/servers/rendering/rendering_device.cpp
@@ -8268,6 +8268,22 @@ uint32_t RenderingDevice::get_frame_delay() const {
 	return frames.size();
 }
 
+bool RenderingDevice::surfaceless_frame_queue = false;
+bool RenderingDevice::surfaceless_pipeline_cache = false;
+
+void RenderingDevice::set_surfaceless_frame_queue(bool p_enable) {
+	surfaceless_frame_queue = p_enable;
+}
+
+void RenderingDevice::set_surfaceless_pipeline_cache(bool p_enable) {
+	surfaceless_pipeline_cache = p_enable;
+}
+
+void RenderingDevice::frame_signal_semaphore_add(RDD::SemaphoreID p_semaphore) {
+	ERR_RENDER_THREAD_GUARD();
+	frames[frame].semaphores_to_signal.push_back(p_semaphore);
+}
