+	if (is_stdio_print_func_set()) {
+		const int static_buf_size = 512;
+		char static_buf[static_buf_size];
+		char *buf = static_buf;
+		// Formatted from copies: p_list is still needed if the text is not taken.
+		va_list list_copy;
+		va_copy(list_copy, p_list);
