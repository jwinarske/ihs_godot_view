diff --git a/core/string/print_string.cpp b/core/string/print_string.cpp
index 67239a9..f3142a7 100644
--- a/core/string/print_string.cpp
+++ b/core/string/print_string.cpp
@@ -33,12 +33,37 @@
 #include "core/core_globals.h"
 #include "core/os/os.h"
 
+#include <atomic>
 #include <cstdio>
 
 static PrintHandlerList *print_handler_list = nullptr;
 static thread_local bool is_printing = false;
+static std::atomic<StdioPrintFunc> stdio_print_func = nullptr;
+
+void set_stdio_print_func(StdioPrintFunc p_func) {
+	stdio_print_func.store(p_func, std::memory_order_release);
+}
+
+bool is_stdio_print_func_set() {
+	return stdio_print_func.load(std::memory_order_acquire) != nullptr;
+}
+
+bool _stdio_print_to_func(const char *p_text, StdioPrintType p_type) {
+	const StdioPrintFunc func = stdio_print_func.load(std::memory_order_acquire);
+	if (!func) {
+		return false;
+	}
+	func(p_text, p_type);
+	return true;
+}
 
 static void __print_fallback(const String &p_string, bool p_err, bool p_reentrance) {
+	const StdioPrintType type = p_err ? STDIO_PRINT_ERROR : STDIO_PRINT_OUTPUT;
+	if ((!p_reentrance || _stdio_print_to_func("While attempting to print an error, another error was printed:\n", type)) &&
+			_stdio_print_to_func((p_string + "\n").utf8().get_data(), type)) {
+		return;
+	}
+
 	if (p_reentrance) {
 		fprintf(p_err ? stderr : stdout, "While attempting to print an error, another error was printed:\n");
 	}
diff --git a/core/string/print_string.h b/core/string/print_string.h
index 673e2d7..5a0078d 100644
--- a/core/string/print_string.h
+++ b/core/string/print_string.h
@@ -51,6 +51,26 @@ String stringify_variants(const Span<Variant> &p_vars);
 void add_print_handler(PrintHandlerList *p_handler);
 void remove_print_handler(const PrintHandlerList *p_handler);
 
+// Some of Godot's output is written straight to stdout or stderr: whatever goes
+// through the terminal logger, and the fallback used before the OS is
+// initialized, during final cleanup, and while a print is already in progress.
+// An embedder whose output must reach its own log can take that text instead.
+// The function gets the text as it would have been written, newlines included
+// (one call may hold several lines or part of one), from any thread, and must
+// not print through Godot.
+enum StdioPrintType {
+	STDIO_PRINT_OUTPUT,
+	STDIO_PRINT_ERROR,
+	STDIO_PRINT_WARNING,
+};
+typedef void (*StdioPrintFunc)(const char *p_text, StdioPrintType p_type);
+
+// nullptr writes to stdout and stderr again.
+void set_stdio_print_func(StdioPrintFunc p_func);
+bool is_stdio_print_func_set();
+// Hands p_text to the function; false when none is set.
+bool _stdio_print_to_func(const char *p_text, StdioPrintType p_type);
+
 extern void __print_line(const String &p_string);
 extern void __print_line_rich(const String &p_string);
 extern void print_raw(const String &p_string);
