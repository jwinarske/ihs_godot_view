@@ -49,6 +50,21 @@ static ErrorHandlerList *error_handler_list = nullptr;
 static thread_local bool is_printing_error = false;
 
 static void _err_print_fallback(const char *p_function, const char *p_file, int p_line, const char *p_error_details, ErrorHandlerType p_type, bool p_reentrance) {
+	if (is_stdio_print_func_set()) {
+		const StdioPrintType type = p_type == ERR_HANDLER_WARNING ? STDIO_PRINT_WARNING : STDIO_PRINT_ERROR;
+		// One line per error, with its location, for a log that keeps lines apart.
+		char line[1024];
+		if (p_function && p_file) {
+			snprintf(line, sizeof(line), "%s: %s (at %s, %s:%i)\n", _error_handler_type_string(p_type), p_error_details, p_function, p_file, p_line);
+		} else {
+			snprintf(line, sizeof(line), "%s: %s\n", _error_handler_type_string(p_type), p_error_details);
+		}
+		if ((!p_reentrance || _stdio_print_to_func("While attempting to print an error, another error was printed:\n", type)) &&
+				_stdio_print_to_func(line, type)) {
+			return;
+		}
+	}
+
 	if (p_reentrance) {
 		fprintf(stderr, "While attempting to print an error, another error was printed:\n");
 	}
