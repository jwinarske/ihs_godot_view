Vulkan: compile for SPIR-V 1.3 on a 1.1 device without VK_KHR_spirv_1_4

The Vulkan shader container targets SPIR-V 1.4 unconditionally (since
ray tracing support), but SPIR-V 1.4 is valid only on Vulkan 1.2 or
with VK_KHR_spirv_1_4 enabled, and the driver enabled neither. On a
Vulkan 1.1 device every shader module is then invalid
(VUID-VkShaderModuleCreateInfo-pCode-08737) and reaches the driver's
compiler anyway.

Request VK_KHR_spirv_1_4 (and VK_KHR_shader_float_controls, which it
requires) when the device offers them, and on a 1.1 device without it
compile for SPIR-V 1.3, as before ray tracing. Ray tracing needs
VK_KHR_spirv_1_4 itself, so it is unaffected. The shader cache key now
includes the SPIR-V version, so binaries cached at the other version are
not loaded.

Applied by godot/CMakeLists.txt on top of GODOT_GIT_REF, after 0001.

--- a/drivers/vulkan/rendering_device_driver_vulkan.cpp
+++ b/drivers/vulkan/rendering_device_driver_vulkan.cpp
@@ -597,6 +597,9 @@
 	_register_requested_device_extension(VK_NV_RAY_TRACING_VALIDATION_EXTENSION_NAME, false);
 	_register_requested_device_extension(VK_KHR_SYNCHRONIZATION_2_EXTENSION_NAME, false);
 	_register_requested_device_extension(VK_KHR_RAY_QUERY_EXTENSION_NAME, false);
+	// Shaders are compiled to SPIR-V 1.4, which a Vulkan 1.1 device accepts only with these.
+	_register_requested_device_extension(VK_KHR_SHADER_FLOAT_CONTROLS_EXTENSION_NAME, false);
+	_register_requested_device_extension(VK_KHR_SPIRV_1_4_EXTENSION_NAME, false);
 
 	// We don't actually use this extension, but some runtime components on some platforms
 	// can and will fill the validation layers with useless info otherwise if not enabled.
@@ -906,6 +909,12 @@
 	// Cache extension availability we query often.
 	framebuffer_depth_resolve = enabled_device_extension_names.has(VK_KHR_DEPTH_STENCIL_RESOLVE_EXTENSION_NAME);
 
+	// SPIR-V 1.4 needs Vulkan 1.2 or VK_KHR_spirv_1_4. Without either, compile for 1.3: nothing
+	// but ray tracing needs 1.4, and ray tracing needs VK_KHR_spirv_1_4 anyway.
+	if (physical_device_properties.apiVersion < VK_API_VERSION_1_2 && !enabled_device_extension_names.has(VK_KHR_SPIRV_1_4_EXTENSION_NAME)) {
+		shader_container_format.set_shader_spirv_version(SHADER_SPIRV_VERSION_1_3);
+	}
+
 	bool use_fdm_offsets = false;
 	if (VulkanHooks::get_singleton() != nullptr) {
 		use_fdm_offsets = VulkanHooks::get_singleton()->use_fragment_density_offsets();
--- a/drivers/vulkan/rendering_shader_container_vulkan.cpp
+++ b/drivers/vulkan/rendering_shader_container_vulkan.cpp
@@ -101,7 +101,11 @@
 }
 
 RenderingDeviceCommons::ShaderSpirvVersion RenderingShaderContainerFormatVulkan::get_shader_spirv_version() const {
-	return SHADER_SPIRV_VERSION_1_4;
+	return spirv_version;
+}
+
+void RenderingShaderContainerFormatVulkan::set_shader_spirv_version(ShaderSpirvVersion p_spirv_version) {
+	spirv_version = p_spirv_version;
 }
 
 void RenderingShaderContainerFormatVulkan::set_debug_info_enabled(bool p_debug_info_enabled) {
